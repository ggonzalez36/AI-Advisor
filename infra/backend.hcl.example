# Copy to backend.hcl (git-ignored) and fill in your values.
# Create the bucket, lock table and KMS key first with the state-backend module
# (see infra/README.md, "Bootstrap the state backend").
bucket         = "my-terraform-state-bucket"
key            = "fin-ai-advisor/prod/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
kms_key_id     = "alias/fin-ai-advisor-tfstate"
dynamodb_table = "fin-ai-advisor-tflock" # On Terraform >= 1.10 use `use_lockfile = true` instead
